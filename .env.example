# ---- Server ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ---- Security ----
# Comma-separated list of API keys accepted by the gateway.
API_KEYS=dev-local-key
CORS_ORIGIN=*
# Re-create the example agent at boot when it is missing. Set false to keep a
# deleted example deleted.
SEED_EXAMPLES=true

# ---- Observability ----
# Expose Prometheus metrics at /metrics (unauthenticated, like /health).
METRICS_ENABLED=true
# Include process, heap, and event-loop-lag metrics.
METRICS_DEFAULT=true

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ---- MongoDB ----
# Unset means agents, memory, and run history live in memory and are lost on
# restart. Set it to make them durable.
MONGODB_URI=mongodb://localhost:27017/bugbaar
# Days of workflow run history to keep. 0 retains forever.
RUN_RETENTION_DAYS=30

# ---- Redis / BullMQ ----
# Unset means background jobs run on in-process timers: they are lost on
# restart and every replica runs its own copy of each repeating job.
REDIS_URL=redis://localhost:6379
# BullMQ forbids ":" in queue names.
QUEUE_NAME=bugbaar-workflows
# Jobs this process handles at once.
QUEUE_CONCURRENCY=4
# Set false to enqueue without consuming, for an API-only tier.
QUEUE_START_WORKER=true

# ---- Qdrant (vector database) ----
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=bugbaar_knowledge

# ---- LLM providers ----
# Leave blank to run with the built-in echo provider (no network calls).
LLM_PROVIDER=echo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# Per-word delay for the echo provider's synthetic stream. Useful for seeing
# streaming work locally without a real model. 0 disables the pacing.
ECHO_CHUNK_DELAY_MS=0
