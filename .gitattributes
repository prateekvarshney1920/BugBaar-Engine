# Normalise to LF in the repository; let Git decide the working-copy ending.
* text=auto

# Shell scripts and Docker assets must keep LF even on Windows checkouts —
# a CRLF shebang line fails with "bad interpreter: no such file or directory".
*.sh text eol=lf
Dockerfile text eol=lf
*.conf text eol=lf

# Never touch these.
*.png binary
*.jpg binary
*.ico binary
